---
import Icon from "../ui/Icon.astro";

const topCards = [
  {
    icon: "camera",
    title: "Analyse par photo (bientôt)",
    text: "Photographiez une feuille ou une motte de terre : l’IA repère les anomalies visibles et vous propose un plan d’action clair pour y remédier.",
  },
  {
    icon: "search",
    title: "Lecture des analyses de laboratoire",
    text: "pH, matière organique, phosphore, potassium : chaque valeur est interprétée, comparée aux seuils de référence et traduite en recommandations.",
  },
];

const bottomCards = [
  {
    icon: "clock",
    title: "Planification intelligente",
    text: "Recevez des rappels d’arrosage, de fertilisation et de chaulage selon votre sol, votre culture et la météo.",
  },
  {
    icon: "chat",
    title: "Assistance experte",
    text: "Une question sur vos résultats ? Contactez notre équipe support directement depuis l’application.",
  },
];

const card = "flex flex-col justify-between gap-[60px] rounded-[20px] bg-white p-8 lg:gap-[100px]";
---

<section class="section-shell">
  <div class="rounded-[20px] bg-mint px-4 py-[60px] md:px-[30px] lg:py-[140px]">
    <div class="container-x flex flex-col items-center gap-[52px]">
      <h2 class="t-h2 text-center" data-reveal>Une exploitation plus sereine, tout en un</h2>

      <div class="flex w-full flex-col gap-4">
        <div class="grid gap-4 md:grid-cols-2" data-reveal>
          {
            topCards.map((c) => (
              <article class={card}>
                <div class="flex flex-col gap-3.5">
                  <h3 class="t-h6">{c.title}</h3>
                  <p class="text-body">{c.text}</p>
                </div>
                <Icon name={c.icon} size={48} />
              </article>
            ))
          }
        </div>

        <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3" data-reveal>
          {
            bottomCards.map((c) => (
              <article class={card}>
                <div class="flex flex-col gap-3.5">
                  <h3 class="t-h6">{c.title}</h3>
                  <p class="text-body">{c.text}</p>
                </div>
                <Icon name={c.icon} size={48} />
              </article>
            ))
          }

          <article class="flex flex-col justify-center gap-[27px] rounded-2xl bg-forest p-8">
            <div class="flex flex-col gap-7">
              <div class="flex flex-col gap-2.5">
                <p class="t-stat text-white"><span data-count="10">10</span><span class="text-snow">k+</span></p>
                <p class="text-sm leading-[22px] text-slate">Parcelles analysées</p>
              </div>
              <div class="border-t border-dashed border-white/15"></div>
              <div class="flex flex-col gap-2">
                <Icon name="quote" size={24} class="text-lime" />
                <p class="text-slate">Enfin une application qui parle le langage du terrain.</p>
              </div>
            </div>
            <div class="flex flex-col gap-0.5">
              <p class="text-sm leading-5 font-medium text-white">Moussa D.</p>
              <p class="text-sm leading-[22px] text-slate">Producteur maraîcher</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>
