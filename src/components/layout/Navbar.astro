---
import Logo from "../ui/Logo.astro";

const links = [
  { label: "Accueil", href: "/" },
  { label: "Fonctionnalités", href: "/fonctionnalites/" },
  { label: "Tarifs", href: "/tarifs/" },
];
---

<header
  id="navbar"
  class="fixed inset-x-0 top-0 z-50 transition-transform duration-500 ease-(--ease-spring) data-[hidden=true]:-translate-y-[110%]"
  transition:persist
>
  <div data-appear="down" class="md:px-[30px] md:py-6">
    <!-- Desktop / tablette -->
    <nav
      class="mx-auto hidden w-fit items-center gap-2.5 rounded-full bg-white py-2.5 pr-2.5 pl-5 shadow-[inset_0_0_0_1px_rgb(14_22_15/0.08)] md:flex"
      aria-label="Navigation principale"
    >
      <Logo />

      <ul class="flex w-[320px] items-center justify-center gap-5 text-sm leading-5 font-medium">
        {
          links.map((l) => (
            <li>
              <a href={l.href} class="transition-colors hover:text-forest">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a href="/telecharger/" class="group relative overflow-hidden rounded-full bg-forest px-4 py-2 text-sm leading-5 font-bold text-white">
        <span class="btn-label">
          <span>Télécharger</span>
          <span aria-hidden="true">Télécharger</span>
        </span>
      </a>
    </nav>

    <!-- Mobile -->
    <nav class="bg-white p-4 md:hidden" aria-label="Navigation mobile" data-mobile-nav data-open="false">
      <div class="flex items-center justify-between">
        <Logo />
        <button type="button" class="relative size-[26px]" aria-label="Menu" aria-expanded="false" data-mobile-toggle>
          <span
            class="absolute top-[9px] left-[5px] h-[1.5px] w-4 rounded-full bg-ink transition-transform duration-300 [[data-open=true]_&]:translate-y-[3.5px] [[data-open=true]_&]:rotate-45"
          ></span>
          <span
            class="absolute top-[16px] left-[5px] h-[1.5px] w-4 rounded-full bg-ink transition-transform duration-300 [[data-open=true]_&]:-translate-y-[3.5px] [[data-open=true]_&]:-rotate-45"
          ></span>
        </button>
      </div>
      <div class="accordion-body">
        <div>
          <ul class="flex flex-col gap-4 pt-[30px] text-sm leading-5 font-medium">
            {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <a href="/telecharger/" class="mt-[30px] flex justify-center rounded-full bg-forest px-4 py-3 text-sm font-bold text-white">
            Télécharger
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>
